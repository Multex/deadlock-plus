{
    "name": "@deadlock-plus/ui",
    "version": "0.0.0",
    "private": true,
    "description": "Deadlock+ theme, fonts and UI components, shared by the desktop app and the website",
    "type": "module",
    "license": "GPL-3.0-or-later",
    "exports": {
        "./peers": {
            "types": "./peers.d.ts",
            "default": "./peers.js"
        },
        "./theme.css": "./src/theme.css",
        "./fonts.css": "./src/fonts.css",
        "./alert-dialog": {
            "types": "./src/alert-dialog/index.ts",
            "svelte": "./src/alert-dialog/index.ts",
            "default": "./src/alert-dialog/index.ts"
        },
        "./dialog": {
            "types": "./src/dialog/index.ts",
            "svelte": "./src/dialog/index.ts",
            "default": "./src/dialog/index.ts"
        },
        "./dropdown-menu": {
            "types": "./src/dropdown-menu/index.ts",
            "svelte": "./src/dropdown-menu/index.ts",
            "default": "./src/dropdown-menu/index.ts"
        },
        "./tabs": {
            "types": "./src/tabs/index.ts",
            "svelte": "./src/tabs/index.ts",
            "default": "./src/tabs/index.ts"
        },
        "./tooltip": {
            "types": "./src/tooltip/index.ts",
            "svelte": "./src/tooltip/index.ts",
            "default": "./src/tooltip/index.ts"
        },
        "./*.svelte": {
            "types": "./src/*.svelte",
            "svelte": "./src/*.svelte",
            "default": "./src/*.svelte"
        },
        "./*": {
            "types": "./src/*.ts",
            "svelte": "./src/*.ts",
            "default": "./src/*.ts"
        }
    },
    "peerDependencies": {
        "@lucide/svelte": "^1.48.0",
        "bits-ui": "^2.19.3",
        "clsx": "^2.1.1",
        "svelte": "^5.56.3",
        "tailwind-merge": "^3.7.0",
        "tailwind-variants": "^3.3.1",
        "tailwindcss": "^4.3.3",
        "tw-animate-css": "^1.4.0"
    }
}
