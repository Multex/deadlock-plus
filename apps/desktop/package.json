{
  "name": "deadlock-plus",
  "version": "0.13.2",
  "description": "Companion app for Deadlock: server picker, connection monitor, mutes, replays and storage",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "format": "prettier --write \"src/**/*.{ts,svelte,css,js,html}\" \"e2e/**/*.{ts,mjs,css}\" \"playwright.config.ts\" \"../../packages/**/*.ts\" \"../../packages/ui/**/*.{svelte,css,js}\" \"!../../packages/ipc-types/**\" \"../../scripts/**/*.mjs\" \"../discord-updates/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{ts,svelte,css,js,html}\" \"e2e/**/*.{ts,mjs,css}\" \"playwright.config.ts\" \"../../packages/**/*.ts\" \"../../packages/ui/**/*.{svelte,css,js}\" \"!../../packages/ipc-types/**\" \"../../scripts/**/*.mjs\" \"../discord-updates/**/*.mjs\"",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p e2e",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "tauri",
    "tauri:dev": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:update": "playwright test visual --update-snapshots",
    "e2e:unit": "node --test \"e2e/support/*.test.mjs\"",
    "e2e:cache:clear": "node -e \"fs.rmSync('e2e/.cache', { recursive: true, force: true })\"",
    "screenshots": "node ../../scripts/screenshots.mjs",
    "demo:build": "node e2e/support/demo.mjs build",
    "demo:preview": "node e2e/support/demo.mjs preview",
    "build:no-demo": "node e2e/support/no-demo-in-build.mjs",
    "licenses": "node ../../scripts/gen-licenses.mjs",
    "version:sync": "node ../../scripts/version.mjs",
    "version:check": "node ../../scripts/version.mjs --check",
    "tiers:check": "node ../../scripts/tiers.mjs",
    "layers:check": "node ../../scripts/frontend-layers.mjs",
    "i18n:check": "node ../../scripts/i18n-check.mjs",
    "loc": "node ../../scripts/loc.mjs"
  },
  "license": "GPL-3.0-or-later",
  "dependencies": {
    "@deadlock-plus/build-layout": "workspace:*",
    "@deadlock-plus/deadlock-api": "workspace:*",
    "@deadlock-plus/ipc-types": "workspace:*",
    "@deadlock-plus/links": "workspace:*",
    "@deadlock-plus/match": "workspace:*",
    "@deadlock-plus/stats": "workspace:*",
    "@deadlock-plus/ui": "workspace:*",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/limelight": "^5.3.0",
    "@lucide/svelte": "^1.48.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-log": "^2.9.2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-updater": "^2.12.0",
    "@twemoji/svg": "^15.0.0",
    "bits-ui": "^2.19.3",
    "clsx": "^2.1.1",
    "html-to-image": "1.11.13",
    "svelte-sonner": "^1.2.1",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1"
  },
  "devDependencies": {
    "@deadlock-plus/demo": "workspace:*",
    "@playwright/test": "1.64.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@types/node": "^24.19.2",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.0.1"
  }
}
