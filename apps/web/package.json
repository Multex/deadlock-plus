{
    "name": "deadlock-plus-web",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "Deadlock+ website: landing page, Discord invite redirect and referrer counts",
    "license": "GPL-3.0-or-later",
    "scripts": {
        "dev": "vite dev",
        "build": "vite build",
        "preview": "wrangler dev",
        "deploy": "vite build && wrangler deploy",
        "prepare": "svelte-kit sync || echo ''",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "test": "vitest run",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "dependencies": {
        "@deadlock-plus/analytics": "workspace:*",
        "@deadlock-plus/links": "workspace:*",
        "@deadlock-plus/ui": "workspace:*",
        "@lucide/svelte": "^1.55.0",
        "bits-ui": "^2.19.5",
        "clsx": "^2.1.1",
        "tailwind-merge": "^3.7.0",
        "tailwind-variants": "^3.3.1"
    },
    "devDependencies": {
        "@cloudflare/workers-types": "^5.20261003.1",
        "@fontsource/limelight": "^5.3.0",
        "@sveltejs/adapter-cloudflare": "^7.2.9",
        "@sveltejs/kit": "^2.65.1",
        "@sveltejs/vite-plugin-svelte": "^7.1.2",
        "@tailwindcss/vite": "^4.3.3",
        "prettier": "^3.9.9",
        "prettier-plugin-svelte": "^4.1.1",
        "svelte": "^5.56.3",
        "svelte-check": "^4.6.0",
        "tailwindcss": "^4.3.3",
        "tw-animate-css": "^1.4.0",
        "typescript": "~6.0.3",
        "vite": "^8.0.16",
        "vitest": "^5.0.1",
        "wrangler": "^4.147.0"
    }
}
