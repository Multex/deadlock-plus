        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "dependencies": {
        "@deadlock-plus/discord-messages": "workspace:*"
    },
    "devDependencies": {
        "@cloudflare/workers-types": "^5.20261003.1",
        "prettier": "^3.9.9",
        "typescript": "^7.0.2",
        "vitest": "^5.0.3",
        "wrangler": "^4.147.0"
    }
}
