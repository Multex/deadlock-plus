{
    "name": "crowdin-relay",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "Relays Crowdin webhooks to Discord as Components V2 messages",
    "license": "GPL-3.0-or-later",
    "scripts": {
        "dev": "wrangler dev",
        "deploy": "wrangler deploy",
        "typecheck": "tsc --noEmit",
